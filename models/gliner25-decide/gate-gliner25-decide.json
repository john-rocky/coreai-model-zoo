  "package": "gliner2 2.0.0",
  "device": "cpu",
  "dtype": "float32",
  "batch": 1,
  "attn_implementation": "eager",
  "path": "model.encoder(input_ids, attention_mask).last_hidden_state -> processor.extract_embeddings_from_batch -> classifier(stack(embs)[1:]).squeeze(-1)",
  "decision_rule": "class_act auto: multi_label -> sigmoid, prob >= cls_threshold (none -> argmax 1); single -> softmax, argmax",
  "versions": {
   "python": "3.12.13",
