   "machine": "arm64",
   "platform": "macOS-27.0-arm64-arm-64bit"
  },
  "script": "conversion/gliner25_decide_oracle.py",
  "self_consistency": "every case's decision equals model.classify_text(...) on every task, probabilities equal (max |dprob| 0.0 on all 787 tasks)",
