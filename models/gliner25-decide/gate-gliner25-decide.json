 "hf_repo": "mlboydaisuke/GLiNER2.5-Decide-CoreAI",
 "gate": {
  "GATE-1": "fp32 re-authored module vs oracle: decisions equal on every task and max |dlogit| <= 1e-3",
  "GATE-2": "label_idx + 1 (each label's first sub-word instead of its [L] marker) must change >= 1 decision",
  "GATE-3": "fp16 bundle vs oracle: decisions equal on every task, every row finite; max |dlogit| and max |dprob| reported, not bounded"
 },
