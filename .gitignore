# Model artifacts & weights (large — never commit; reproduce via conversion/)
*.aimodel/
*.aimodelx/
*.mlpackage/
*.mlmodelc/
*.safetensors
*.gguf
*.bin
*.pt
artifacts/
# Oracle captures written by conversion/pocket-tts/gen_oracle.py (npz + wav + json, MBs,
# regenerated by the recipe's prerequisite step).
conversion/oracle/
weights/
# Oracle reference dumps — regenerate with the _smoke/*_ref.py that wrote them
_smoke/*.npz
_smoke/*.npy
_smoke/qwen38vl_images/
# Swift / Xcode
.build/
DerivedData/
*.xcuserstate
xcuserdata/
Package.resolved
# coreai-models clone (or symlink) at the repo root — required by apps/ and by
# swift/'s ZooFMProvider target (see apps/README.md, swift/README.md)
/coreai-models
# Python
.venv/
__pycache__/
*.pyc
# macOS
.DS_Store
# Apps: Xcode projects are generated (xcodegen); tokenizer.json is large — fetch from the
# upstream model repos (see apps/CoreAIChat/README.md)
apps/**/*.xcodeproj/
apps/**/build/
apps/**/build_mac/
apps/**/_selftest_*.log
apps/**/build-*/
apps/**/.build_*/
apps/**/tokenizer.json

# VoxCPM scratch experiments (not shipped)
conversion/voxcpm/scratch_*.py

# VoxCPM dev asset symlink (points at conversion artifacts; machine-specific)
apps/coreai-audio/Sources/VoxCPMAssets

# Working logs from device builds / smoke gates (local R&D artifacts)
*.log

# Hugging Face listing/metadata cache (scripts/gen_inventory.py, conversion/zoo_verify.py)
.cache/

# uv writes these next to a PEP-723 script when resolving (uv lock --script)
*.py.lock
cli/build/
cli/*.egg-info/
cli/dist/
